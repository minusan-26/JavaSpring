import ch.qos.logback.core.net.SyslogOutputStream;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
//I Love Java and I Love Coding in Java 
//output =  java -> 2,love ->2,i->2,and->1,coding ->1,in ->1
public class Hello {
    public static void main(String[] args){
        String str = "I Love Java and I Love Coding in Java";
        String[] strarr = str.split(" ");
        int count=1;
        Object[] array = Arrays.stream(strarr).sorted().toArray();
        List listarr= List.of(array);
        System.out.println(listarr.size());
        for(int i=0; i<array.length;i++){
            if (array.length-1 != i && listarr.get(i).equals(listarr.get(i + 1))) {
                count ++;
            }else {
                System.out.println(listarr.get(i)+"->"+count);
                count=1;
            }
        }
    }
}
